# Docker build context — keep it small and secret-free.
# The three app Dockerfiles build from the repo root (turbo prune).

# Dependencies & build output (recreated inside the image)
**/node_modules
**/.next
**/.next-e2e
**/.source
**/.turbo
**/dist
**/coverage
**/playwright-report
**/test-results
**/.playwright-mcp-artifacts
**/*.tsbuildinfo
**/.evlog

# Secrets / local env — never enter the build context
**/.env
**/.env.*

# VCS & tooling
.git
.github
.vscode
.idea
.fuutu
.shadcn-staging
.pnpm-store
# Agent tooling: worktrees (whole repo copies) and private overlays
.claude
CLAUDE.local.md

# Tests are not needed to build or run the apps — except the app-owned
# exclusion list: playwright.config.ts imports it and `next build`
# type-checks that config.
apps/*/tests
!apps/*/tests/app-excluded.ts

# Repo-only assets / docs / deploy helpers
# (/docs is anchored to the repo root — do NOT match apps/docs)
assets
/docs
tmp
temp
out
*.tgz
*.bak
*.bak[0-9]*
docker-compose.deploy*.yml
