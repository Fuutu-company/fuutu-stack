{
	"$schema": "https://schema.railpack.com",
	"packages": { "node": "24" },
	"steps": {
		"build": {
			"commands": [
				"node packages/telemetry/bin/ping.mjs || true",
				"SKIP_ENV_VALIDATION=1 pnpm --filter @fuutu/marketing build",
				"cp -r apps/marketing/.next/static apps/marketing/.next/standalone/apps/marketing/.next/static",
				"cp -r apps/marketing/public apps/marketing/.next/standalone/apps/marketing/public"
			]
		}
	},
	"deploy": {
		"inputs": [
			{
				"step": "packages:mise",
				"include": [
					"/mise/shims",
					"/mise/installs",
					"/usr/local/bin/mise",
					"/etc/mise/config.toml",
					"/root/.local/state/mise"
				]
			},
			{ "step": "build", "include": ["apps/marketing/.next/standalone"] }
		],
		"startCommand": "node apps/marketing/.next/standalone/apps/marketing/server.js",
		"variables": {
			"HOSTNAME": "0.0.0.0",
			"PORT": "3001",
			"NODE_ENV": "production"
		}
	}
}
