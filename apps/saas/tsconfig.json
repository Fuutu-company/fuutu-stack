{
	"extends": "@fuutu/tsconfig/nextjs.json",
	"compilerOptions": {
		"paths": {
			"@/*": ["./src/*"],
			"@app/*": ["./src/modules/app/*"],
			"@auth/*": ["./src/modules/auth/*"],
			"@shared/*": ["./src/modules/shared/*"]
		}
	},
	"include": ["./**/*.ts", "./**/*.tsx"],
	"exclude": ["./node_modules"]
}
