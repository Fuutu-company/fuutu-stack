{
	"name": "@fuutu/desktop-app",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"//": "No `dev`/`build` scripts on purpose: `pnpm dev` / `pnpm build` (turbo) never touch the desktop app. Use the root `pnpm dev:desktop` / `pnpm build:desktop`, which respect `config.features.desktop`.",
	"scripts": {
		"web:dev": "next dev",
		"web:build": "next build",
		"tauri": "tauri",
		"check-types": "next typegen && tsc --noEmit --incremental false",
		"test": "vitest run",
		"smoke": "node tests/smoke.mcp.mjs"
	},
	"dependencies": {
		"@fuutu/config": "workspace:*",
		"@fuutu/desktop": "workspace:*",
		"@fuutu/env": "workspace:*",
		"@fuutu/i18n": "workspace:*",
		"@fuutu/ui": "workspace:*",
		"@fuutu/utils": "workspace:*",
		"@tanstack/react-query": "catalog:",
		"@tauri-apps/api": "catalog:",
		"@tauri-apps/plugin-autostart": "catalog:",
		"@tauri-apps/plugin-log": "catalog:",
		"@tauri-apps/plugin-opener": "catalog:",
		"@tauri-apps/plugin-process": "catalog:",
		"lucide-react": "catalog:",
		"next": "catalog:",
		"next-intl": "catalog:",
		"next-themes": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "catalog:",
		"@fuutu/tsconfig": "workspace:*",
		"@hypothesi/tauri-mcp-server": "catalog:",
		"@tailwindcss/postcss": "catalog:",
		"@tauri-apps/cli": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"postcss": "catalog:",
		"tailwindcss": "catalog:",
		"tsx": "catalog:",
		"tw-animate-css": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
