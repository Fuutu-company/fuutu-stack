{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "desktop-app",
	"version": "0.0.0",
	"identifier": "app.desktop.placeholder",
	"build": {
		"frontendDist": "../out"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "desktop-app",
				"width": 1100,
				"height": 720,
				"minWidth": 720,
				"minHeight": 480
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
