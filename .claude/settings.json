{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"enabledMcpjsonServers": [
		"fuutu",
		"better-auth",
		"next-devtools",
		"shadcn",
		"playwright"
	],
	"permissions": {
		"allow": [
			"Bash(pnpm check)",
			"Bash(pnpm check-types)",
			"Bash(pnpm test)",
			"Bash(pnpm test *)",
			"Bash(pnpm check-translations)"
		],
		"deny": [
			"Read(./**/.env)",
			"Read(./**/.env.local)",
			"Read(./**/.env.production)"
		],
		"ask": [
			"Bash(git push *)",
			"Bash(git commit *)",
			"Bash(pnpm db:migrate *)",
			"Bash(pnpm db:push *)"
		]
	},
	"plansDirectory": "./docs/plans"
}
