# =============================================================================
# Fuutu Stack — environment variables
# -----------------------------------------------------------------------------
# Schemas (validated at import time via @t3-oss/env-nextjs):
#   - packages/env/src/saas.ts      → SaaS app + packages
#   - packages/env/src/marketing.ts → marketing app (public `NEXT_PUBLIC_*` only)
# Any var you add here MUST also be added to the matching schema.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Prisma 7 + Postgres)
# -----------------------------------------------------------------------------
# Default matches the docker-compose in packages/db/docker-compose.yml
DATABASE_URL="postgresql://postgres:password@localhost:5432/fuutu-stack"

# -----------------------------------------------------------------------------
# Authentication (Better-Auth 1.6)
# -----------------------------------------------------------------------------
# Generate a fresh secret per environment: `openssl rand -base64 32`
# ⚠️ MUST ROTATE for production — this dev default must never be used in prod.
BETTER_AUTH_SECRET="gVq2v3iiw7jd5dggl/z6Vk1iPqUMhMinbKq56R/Z6x8="
# Where the auth handler is mounted (Next.js /api/auth/* route).
BETTER_AUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Server / runtime
# -----------------------------------------------------------------------------
# NODE_ENV is set automatically by the runtime (development/dev, production/build).
# Do NOT set it here — setting NODE_ENV=development in .env breaks `next build`
# which requires NODE_ENV=production.
# Origin allowed to call the SaaS API (Hono CORS).
CORS_ORIGIN="http://localhost:3000"

# -----------------------------------------------------------------------------
# Public app URLs (NEXT_PUBLIC_* — exposed in the browser bundle)
# -----------------------------------------------------------------------------
# Used for cross-app links, OAuth redirects, email links, sitemaps.
NEXT_PUBLIC_MARKETING_URL="http://localhost:3001"
NEXT_PUBLIC_SAAS_URL="http://localhost:3000"
NEXT_PUBLIC_DOCS_URL="http://localhost:4000"

# -----------------------------------------------------------------------------
# OAuth providers (optional — leave empty to disable)
# -----------------------------------------------------------------------------
# GitHub:  https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Google:  https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Mail (@fuutu/mail) — v1 active provider: Plunk
# -----------------------------------------------------------------------------
# Provider: "console" (dev), "noop", "plunk" (active), "resend", "nodemailer",
#           "postmark", "mailgun"
EMAIL_PROVIDER="console"
EMAIL_FROM="Fuutu <noreply@fuutu.com>"
# Only needed when EMAIL_PROVIDER=plunk    — https://useplunk.com
PLUNK_API_KEY=""
# Only needed when EMAIL_PROVIDER=resend   — https://resend.com
RESEND_API_KEY=""

# -----------------------------------------------------------------------------
# Payments (@fuutu/payments) — provider-swappable (Polar | Stripe | Creem)
# -----------------------------------------------------------------------------
# Set `provider` in packages/payments/src/config.ts.
# Each provider needs its API key + webhook secret below.

# Polar (https://polar.sh)
POLAR_ACCESS_TOKEN=""
POLAR_PRODUCT_ID=""
POLAR_SUCCESS_URL="http://localhost:3000/dashboard"
POLAR_WEBHOOK_SECRET=""

# Stripe (https://stripe.com)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Creem (https://creem.io) — test mode uses creem_test_ prefix
CREEM_API_KEY=""
CREEM_WEBHOOK_SECRET=""
CREEM_TEST_MODE="true"

# Plan price/product IDs (provider-agnostic)
# Set to your active provider's ID for each plan:
#   Stripe → price_id (price_xxx)
#   Creem  → product_id (prod_xxx)
#   Polar  → product_id (xxx-xxx-xxx)
PAYMENTS_PRO_PRICE_ID=""
PAYMENTS_PRO_YEARLY_PRICE_ID=""

# Credit top-up package price IDs (provider-agnostic)
# Set to your active provider's ID for each credit package:
#   Stripe → price_id (price_xxx)
#   Creem  → product_id (prod_xxx)
#   Polar  → product_id (xxx-xxx-xxx)
CREDITS_AI_TOKENS_100K_PRICE_ID=""
CREDITS_AI_TOKENS_500K_PRICE_ID=""
CREDITS_API_CALLS_50K_PRICE_ID=""

# -----------------------------------------------------------------------------
# Storage (@fuutu/storage) — v1 active provider: S3 + MinIO locally
# -----------------------------------------------------------------------------
# https://min.io — defaults match docker-compose in packages/db/docker-compose.yml.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
# ⚠️ MUST CHANGE for production — these MinIO dev defaults must never be used in prod.
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
# Bucket names are env-driven so each environment can use its own physical
# buckets. When multiple environments share the same S3 service (e.g. one
# MinIO instance), prefix the names: dev_avatars, prod_avatars, etc.
S3_BUCKET_AVATARS="avatars"
S3_BUCKET_ORGANIZATION_LOGOS="organization-logos"
S3_FORCE_PATH_STYLE="true"
# ⚠️ MUST CHANGE for production — these MinIO dev defaults must never be used in prod.
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"

# -----------------------------------------------------------------------------
# Analytics (@fuutu/analytics) — v1 active provider: Umami
# -----------------------------------------------------------------------------
# Skeletons: "plausible" / "pirsch" / "mixpanel" / "ga4" / "noop".
NEXT_PUBLIC_ANALYTICS_PROVIDER="umami"
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
# Optional self-hosted Umami script URL — leave empty to use cloud.umami.is.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=""

# -----------------------------------------------------------------------------
# Observability (@fuutu/logs) — evlog-backed, console always on
# -----------------------------------------------------------------------------
# LOG_DRAIN selects additional drain adapters beyond evlog's built-in console
# output. Comma-separated for multiple. Console is always on (evlog default).
#
#   ""              → console only (default, no credentials needed)
#   "sentry"        → Sentry Logs (needs SENTRY_DSN) — https://sentry.io
#   "axiom"         → Axiom (needs AXIOM_API_KEY + AXIOM_DATASET) — https://axiom.co
#   "fs"            → NDJSON files in .evlog/logs/ (local dev/agent debugging)
#   "memory"        → in-memory ring buffer (dev/agents, edge runtimes)
#   "sentry,fs"     → both
LOG_DRAIN=""
# Sentry (only needed when LOG_DRAIN includes "sentry")
SENTRY_DSN=""
# Axiom (only needed when LOG_DRAIN includes "axiom")
AXIOM_API_KEY=""
AXIOM_DATASET=""

# -----------------------------------------------------------------------------
# AI (@fuutu/ai) — optional, only used by AI helper routes
# -----------------------------------------------------------------------------
# Generic AI provider selection — preferred over the legacy key below.
# AI_PROVIDER selects the active provider: "openrouter" (default), "google",
# "openai", "anthropic", "noop".
# OpenRouter is an OpenAI-compatible gateway routing to many model vendors
# (OpenAI, Anthropic, Google, Meta, …) behind a single API key. Get one at
# https://openrouter.ai. Model ids are vendor-prefixed, e.g.
# "openai/gpt-4o-mini", "anthropic/claude-3.5-sonnet".
AI_PROVIDER=""
AI_API_KEY=""
AI_BASE_URL=""
AI_MODEL=""
# Legacy: Google Generative AI key. Prefer AI_PROVIDER + AI_API_KEY above.
GOOGLE_GENERATIVE_AI_API_KEY=""

# Cron (@fuutu/cron) — optional, only used by scheduled job runner
# -----------------------------------------------------------------------------
# CRON_PROVIDER selects the job runner: "inline" (default, in-process) or
# "trigger-dev" (managed scheduler — requires @trigger.dev/sdk setup).
CRON_PROVIDER=""

# -----------------------------------------------------------------------------
# Fuutu Business License & Telemetry (LICENSE.md §6 + §7)
# -----------------------------------------------------------------------------
# Get a key at https://stack.fuutu.com/pricing — required above Free-tier
# thresholds (10 employees / 250k EUR revenue).
FUUTU_LICENSE_KEY=""
# Set to "1" to opt-out of anonymous build-time telemetry (DSGVO).
# The ping is non-blocking and fails silently — disabling it is documented
# and explicitly allowed by LICENSE.md §7. Falsifying the payload is not.
FUUTU_TELEMETRY_DISABLED="0"

# Set to "1" to disable Better Auth rate limiting (CI E2E, load testing).
# Only use in non-production environments.
FUUTU_DISABLE_RATE_LIMIT="0"
