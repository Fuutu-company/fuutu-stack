generator client {
  provider        = "prisma-client"
  output          = "../generated"
  engineType      = "client"
  // Partial unique indexes (`@@unique(..., where: …)`) — generated by
  // `prisma migrate dev` instead of hand-written SQL.
  previewFeatures = ["partialIndexes"]
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "../zod"
  config   = "./zod-generator.config.json"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "app"]
}
