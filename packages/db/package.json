{
	"name": "@fuutu/db",
	"type": "module",
	"exports": {
		".": {
			"default": "./index.ts"
		},
		"./internal/client": {
			"default": "./prisma/client.ts"
		},
		"./zod": {
			"default": "./prisma/zod/index.ts"
		}
	},
	"scripts": {
		"test": "vitest run",
		"test:integration": "cross-env RUN_DB_TESTS=1 dotenv -c -e ../../.env -- vitest run --config vitest.integration.config.ts",
		"check-types": "tsc --noEmit",
		"db:push": "dotenv -c -e ../../.env -- prisma db push",
		"db:generate": "dotenv -c -e ../../.env -- prisma generate",
		"db:migrate": "dotenv -c -e ../../.env -- prisma migrate dev",
		"db:studio": "dotenv -c -e ../../.env -- prisma studio",
		"db:start": "docker compose up -d",
		"db:watch": "docker compose up",
		"db:stop": "docker compose stop",
		"db:down": "docker compose down",
		"db:seed": "dotenv -c -e ../../.env -- node --import tsx/esm ./prisma/seed.ts"
	},
	"dependencies": {
		"@better-auth/utils": "catalog:",
		"@fuutu/env": "workspace:*",
		"@fuutu/logs": "workspace:*",
		"@fuutu/utils": "workspace:*",
		"@prisma/adapter-pg": "catalog:",
		"@prisma/client": "catalog:",
		"decimal.js": "catalog:",
		"pg": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@fuutu/tsconfig": "workspace:*",
		"@types/pg": "catalog:",
		"cross-env": "catalog:",
		"dotenv": "catalog:",
		"prisma": "catalog:",
		"prisma-zod-generator": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
