{
	"extends": "@fuutu/tsconfig/react-library.json",
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": "src",
		"jsx": "react-jsx",
		"paths": {
			"@/*": ["./src/*"],
			"@/components/*": ["./src/components/*"],
			"@/lib/*": ["./src/lib/*"],
			"@/hooks/*": ["./src/hooks/*"]
		}
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}
